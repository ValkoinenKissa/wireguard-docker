# ==========================================
# VirtualBox test environment
# ==========================================

# VirtualBox guest
SERVER_LAN_IP=127.0.0.1

# ==========================================
# WireGuard
# ==========================================

# Host port forwarded to guest UDP 51820
WG_PUBLIC_PORT=51820

# ==========================================
# Caddy
# ==========================================

# Caddy HTTPS PORT
CADDY_HTTPS_PORT=443

# ==========================================
# Docker - WireGuard network
# ==========================================

WG_DOCKER_SUBNET=10.42.42.0/24
WG_DOCKER_IP=10.42.42.42

# ==========================================
# Docker - Reverse proxy network
# ==========================================

PROXY_SUBNET=172.30.0.0/24
WG_PROXY_IP=172.30.0.3
CADDY_DOCKER_IP=172.30.0.2